<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin_perfil</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/admin_forms.css">
</head>
<body>
    <%- include('../../Publico/partials/header.ejs') %>
    <%- include('../../Publico/partials/navbar.ejs') %>
    <main class="app-main">
    <header class="page-header">
        <h1 class="page-title">Perfil do Admin</h1>
        <p class="page-subtitle">Gerencie animais, responsáveis, adoções, veterinários e exames</p>

    </header>


    <div class="sections" style="padding: 10px;">

        <div class="section">
            <button class="accordion">Animais</button>
            <div class="panel">
            <div class="form-card">
            <form action="/animal/buscarPorId" method="GET">
                <label for="id_animal">Id do animal</label>
                <input type="number" id="id_animal" name="id" required class="form-control">
                <div class="text-end"><button type="submit" class="btn btn-primary">Buscar por ID</button></div>
            </form>
            </div>
            <h3>Lista de animais cadastrados:</h3>
            <div class="table-responsive">
            <table class="responsive-table" >
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Nome</th>
                        <th>Raça</th>
                        <th>Adotado</th>
                        <th>ações</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (!animais || animais.length === 0) { %>
                    <tr>
                        <td colspan="5">Nenhum animal cadastrado.</td>
                    </tr>
                    <% } else { %>
                    <% (animais || []).forEach(function(animal) { %>
                    <tr>
                        <td data-label="ID"><%= animal.id %></td>
                        <td data-label="Nome"><%= animal.nome %></td>
                        <td data-label="Raça"><%= animal.raca %></td>
                        <td data-label="Adotado"><%= animal.adotado ? 'Sim' : 'Não' %></td>
                        <% if (animal.adotado) { %>
                        <td data-label="Ações">
                            <form action="/animal/devolver?_method=PUT" method="POST" style="display:inline;">
                                <input type="hidden" name="id" value="<%= animal.id %>">
                                <button class="btn btn-warning" type="submit" onclick="return confirm('Tem certeza que deseja devolver este animal?');"><i class="bi bi-arrow-counterclockwise bs-warning md"></i>Devolver</button>
                            </form>
                        </td>
                        <% } else { %>
                        <td data-label="Ações">
                            <form action="/animal/deletar?_method=DELETE" method="POST" style="display:inline;">
                                <input type="hidden" name="id" value="<%= animal.id %>">
                                <button class="btn btn-danger" type="submit" onclick="return confirm('Tem certeza que deseja deletar este animal?');"><i class="bi bi-trash-fill bs-danger md"></i></button>
                            </form>
                        </td>
                        <% } %>
                    </tr>
                    <% }); %>
                    <% } %>
                </tbody>
            </table>
            </div>

            <div class="form-card">
            <form action="/animal/criar" method="POST">
                <label>Nome</label>
                <input type="text" name="nome" class="form-control">
                <label>Raça</label>
                <input type="text" name="raca" class="form-control">
                <label>Tipo</label>
                <input type="text" name="tipo" class="form-control">
                <label>Descrição</label>
                <textarea name="descricao" class="form-control" rows="4" required></textarea>
                <div class="text-end"><button type="submit" class="btn btn-success">Cadastrar novo</button></div>
            </form>
            </div>

            </div>
        </div>


        <div class="section">
            <button class="accordion">Responsáveis</button>
            <div class="panel">
            <h3>Listar todos responsáveis</h3>
            <div class="form-card">
            <form action="/responsavel/responsavelPorId" method="POST">
                <label for="id_responsavel">Id do responsável</label>
                <input type="text" id="id_responsavel" name="id_responsavel" required class="form-control">
                <div class="text-end"><button type="submit" class="btn btn-primary">Buscar por ID</button></div>
            </form>
            </div>
            <div class="table-responsive">
            <table class="responsive-table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Nome</th>
                        <th>Email</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (!responsaveis || responsaveis.length === 0) { %>
                    <tr>
                        <td colspan="3">Nenhum responsável encontrado.</td>
                    </tr>
                    <% } else { %>
                    <% (responsaveis || []).forEach(function(responsavel) { %>
                    <tr>
                        <td data-label="ID"><%= responsavel.id %></td>
                        <td data-label="Nome"><%= responsavel.nome %></td>
                        <td data-label="Email"><%= responsavel.email %></td>
                    </tr>
                    <% }); %>
                    <% } %>
                </tbody>
            </table>
            </div>
        </div>
    </div>


    <div class="section">
        <button class="accordion">Adoções</button>
        <div class="panel">
        <h3>Listar todas as adoções</h3>
        <form action="/adocao/listarPorResponsavel" method="POST">
            <label for="responsavel_nome">Nome do responsável</label>
            <input type="text" id="responsavel_nome" name="responsavel_nome" required class="form-control">
            <div class="text-end mt-2"><button type="submit" class="btn btn-primary">Listar adoções por responsável</button></div>
        </form><br>
        <div class="table-responsive">
        <table class="responsive-table">
            <thead>
                <tr>
                    <th>Responsável</th>
                    <th>ID do Animal</th>
                    <th>Nome do Animal</th>
                    <th>Data da Adoção</th>
                </tr>
            </thead>
            <tbody>
                <% if (!adocoes || adocoes.length === 0) { %>
                <tr>
                    <td colspan="4">Nenhuma adoção registrada.</td>
                </tr>
                <% } else { %>
                <% (adocoes || []).forEach(function(adocao) { %>
                <tr>
                    <td data-label="Responsável"><%= adocao.responsavel ? adocao.responsavel.nome : adocao.responsavel_nome %></td>
                    <td data-label="ID do Animal"><%= adocao.animal_id %></td>
                    <td data-label="Nome do Animal"><%= adocao.animal ? adocao.animal.nome : adocao.animal_nome %></td>
                    <td data-label="Data da Adoção"><%= adocao.data_adocao %></td>
                </tr>
                <% }); %>
                <% } %>
            </tbody>
        </table>
        </div>
    </div>
    </div>


    <div class="section">
        <button class="accordion">Veterinários</button>
        <div class="panel">
        <h3>Listar todos os veterinários</h3>
        <div class="table-responsive">
        <table class="responsive-table">
            <thead>
                <tr>
                    <th>Nome</th>
                    <th>Prontuário</th>
                    <th>Formação</th>
                    <th>Deletar</th>
                </tr>
            </thead>
            <tbody>
                <% if (!veterinarios || veterinarios.length === 0) { %>
                <tr>
                    <td colspan="3">Nenhum veterinário cadastrado.</td>
                </tr>
                <% } else { %>
                <% (veterinarios || []).forEach(function(vet) { %>
                <tr>
                    <td data-label="Nome"><%= vet.nome %></td>
                    <td data-label="Prontuário"><%= vet.prontuario %></td>
                    <td data-label="Formação"><%= vet.formacao %></td>
                    <td data-label="Deletar">
                        <form action="/veterinario/deletar?_method=DELETE" method="POST" onsubmit="return confirm('Tem certeza que deseja deletar este veterinário?');">
                            <input type="hidden" name="id" value="<%= vet.id %>">
                            <button type="submit" class="btn btn-danger btn-sm"><i class="bi bi-trash-fill bs-danger md"></i></button>
                        </form>
                </tr>
                <% }); %>
                <% } %>
            </tbody>
        </table>
        </div>

        <div class="form-card">
        <form action="/veterinario/criarVet" method="POST">
            <label>Nome</label>
            <input type="text" name="nome" required class="form-control">
            <label>Prontuário</label>
            <input type="text" name="prontuario" required class="form-control">
            <label>Formação</label>
            <input type="text" name="formacao" required class="form-control">
            <label>Senha</label>
            <input type="password" name="senha" required class="form-control">
            <div class="text-end"><button type="submit" class="btn btn-success">Cadastrar novo</button></div>
        </form>
        </div>

        </div>
    </div>


    <div class="section">
        <button class="accordion">Exames</button>
        <div class="panel">
        <h3>Listar todos os exames</h3>
        <div class="table-responsive">
        <table class="responsive-table">
            <thead>
                <tr>
                    <th>Animal</th>
                    <th>Raça</th>
                    <th>Veterinário</th>
                    <th>Prontuario</th>
                    <th>Data do Exame</th>
                    <th>Resultados</th>
                </tr>
            </thead>
            <tbody>
                <% if (!exames || exames.length === 0) { %>
                <tr>
                    <td colspan="4">Nenhum exame registrado.</td>
                </tr>
                <% } else { %>
                <% (exames || []).forEach(function(exame) { %>
                <tr>
                    <td data-label="Animal"><%= exame.animal.nome %></td>
                    <td data-label="Raça"><%= exame.animal.raca %></td>
                    <td data-label="Veterinário"><%= exame.veterinario.nome %></td>
                    <td data-label="Prontuario"><%= exame.prontuario_vet %></td>
                    <td data-label="Data do Exame"><%= exame.data_exame %></td>
                    <td data-label="Resultados"><%= exame.observacoes %></td>
                </tr>
                <% }); %>
                <% } %>
            </tbody>
        </table>
        </div>

        <div class="form-card">
        <form action="/exame/criarExame" method="POST">
            <label for="id_animal">Id do animal</label>
            <input type="text" id="id_animal" name="id_animal" required class="form-control">
            <label for="vet_prontuario">Prontuário do Veterinário</label>
            <input type="text" id="vet_prontuario" name="vet_prontuario" required class="form-control">
            <label for="resultados">Resultados</label>
            <input type="text" id="resultados" name="resultados" required class="form-control">
            <div class="text-end"><button type="submit" class="btn btn-success">Cadastrar exame</button></div>
        </form>
        </div>

        <div class="form-card">
        <form action="/exame/listarPorVet" method="POST">
            <label for="vet_prontuario_list">Prontuário do veterinário</label>
            <input type="text" id="vet_prontuario_list" name="vet_prontuario" required class="form-control">
            <div class="text-end"><button type="submit" class="btn btn-primary">Listar exames por veterinário</button></div>
        </form>
        </div>
        </div>
    </div>

    </div> <!-- .sections -->

            <div class="form-card" style="max-width:220px; text-align:center;">
            <form action="/admin/logout" method="GET">
                <button class="btn btn-danger" type="submit">Logout</button>
            </form>
            </div>
    </main>

    <%- include('../../Publico/partials/footer.ejs') %>

    <script src="/Scripts/admin.js"></script>
</body>
</html>