<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin_perfil</title>
    <style>
        :root{
            --gap: 16px;
            --card-bg: #f9f9f9;
            --card-border: #e6e6e6;
        }

        /* layout container: place sections in columns (row) */
        .sections{
            display: flex;
            gap: var(--gap);
            align-items: flex-start;
            justify-content: space-between;
            margin-top: 12px;
            flex-wrap: wrap;
        }

        /* each section becomes a card/column */
        .section{
            flex: 1 1 160px;
            min-width: 160px;
            background: var(--card-bg);
            border: 1px solid var(--card-border);
            border-radius: 6px;
            padding: 8px;
            box-sizing: border-box;
        }

        /* when a section is opened, expand it to full width so all columns are visible */
        .section.open{
            flex: 1 1 100%;
            min-width: 100%;
            z-index: 2;
        }

        .accordion {
            background-color: #eee;
            color: #444;
            cursor: pointer;
            padding: 12px 14px;
            width: 100%;
            border: none;
            text-align: left;
            outline: none;
            font-size: 16px;
            transition: 0.2s;
            margin-top: 6px;
            border-radius: 4px;
        }
        .active, .accordion:hover {
            background-color: #ddd;
        }
        .panel {
            padding: 8px 6px 0 6px;
            display: none;
            background-color: transparent;
            overflow: auto;
        }

        /* responsive table wrapper */
        .table-responsive{
            overflow-x: auto;
            -webkit-overflow-scrolling: touch;
            margin-top: 8px;
        }

        table.responsive-table{
            width: 100%;
            border-collapse: collapse;
            text-align: left;
            min-width: 0;
            table-layout: auto;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            font-size: 14px;
            color: #2b2b2b;
        }
        table.responsive-table th, table.responsive-table td{
            padding: 8px 10px;
            border: 1px solid #e0e6eb;
            white-space: normal;
            word-break: break-word;
            overflow-wrap: anywhere;
            vertical-align: top;
        }

        /* header styling */
        table.responsive-table thead th{
            background: linear-gradient(180deg,#f6fbfe,#eef7fb);
            color: #123;
            font-weight: 700;
            text-transform: none;
            font-size: 13px;
        }

        /* zebra rows */
        table.responsive-table tbody tr:nth-child(odd){
            background: #fbfdff;
        }

        /* when a section is opened: use a smaller font and tighter padding so content fits without cutting
           but keep all columns and content visible (no text removed) */
        .section.open table.responsive-table{
            font-size: 12px;
        }
        .section.open table.responsive-table th,
        .section.open table.responsive-table td{
            padding: 6px 6px;
        }

        /* optional: slightly reduce input/button sizes inside open section to free space */
        .section.open input, .section.open button{
            font-size: 12px;
            padding: 6px 8px;
        }

        /* small screens: stack sections vertically */
        @media (max-width: 800px){
            .sections{flex-direction: column;}
            .section{min-width: auto}
            table.responsive-table{min-width: 0}
            /* stacked table: show rows as blocks with label before value */
            table.responsive-table thead{display:none}
            table.responsive-table, table.responsive-table tbody, table.responsive-table tr, table.responsive-table td{
                display:block;
                width:100%;
            }
            table.responsive-table tr{margin-bottom:12px;border-bottom:1px solid #eee;padding:6px 0}
            table.responsive-table td{padding:8px 8px 8px 45%;position:relative;text-align:left;border:0}
            table.responsive-table td::before{content:attr(data-label);position:absolute;left:8px;top:8px;width:40%;font-weight:600}
        }
        /* large screens: use grid with 4 columns so the 5th (Exames) can be placed under the 4th
           and occupy only that column (aligned to the right of Veterinários). */
        @media (min-width: 1000px){
            .sections{
                display: grid;
                grid-template-columns: repeat(4, 1fr);
                gap: var(--gap);
            }
            .section{
                flex: none;
                min-width: 0;
            }
            /* place the 5th section (Exames) under column 4 when it's NOT open */
            .sections .section:not(.open):nth-child(5){
                grid-column: 4 / 5;
                grid-row: 2 / 3;
                justify-self: stretch;
            }
            /* when a section opens in grid mode, make it span full width */
            .section.open{grid-column: 1 / -1;}
        }
        /* extra-wide screens: allow 5 columns so Exames stays on the same row as Veterinários */
        @media (min-width: 1400px){
            .sections{ grid-template-columns: repeat(5, 1fr); }
            /* put Exames on the same first row when NOT open; if it's open it will span full width */
            .sections .section:not(.open):nth-child(5){ grid-column: 5 / 6; grid-row: 1 / 2; }
        }

        /* page title styles */
        .page-header{
            text-align: center;
            margin: 18px 0 8px 0;
        }
        .page-title{
            display: inline-block;
            margin: 0;
            padding: 12px 22px;
            border-radius: 12px;
            background: linear-gradient(135deg,#6dd5ed 0%, #2193b0 100%);
            color: #ffffff;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            font-size: 24px;
            box-shadow: 0 6px 18px rgba(33,147,176,0.18);
            letter-spacing: 0.6px;
        }
        .page-subtitle{
            margin: 8px 0 0 0;
            color: #555;
            font-size: 13px;
        }

        @media (max-width: 600px){
            .page-title{font-size:18px;padding:10px 14px}
            .page-subtitle{font-size:12px}
        }
    </style>
</head>
<body>
    <header class="page-header">
        <h1 class="page-title">Perfil do Admin</h1>
        <p class="page-subtitle">Gerencie animais, responsáveis, adoções, veterinários e exames</p>
    </header>


    <div class="sections">

    <div class="section">
        <button class="accordion">Animais</button>
        <div class="panel">
        <form action="/animal/buscarPorId" method="GET">
            Id do animal: <input type="number" id="id_animal" name="id" required>
            <button type="submit">Buscar por ID</button>
        </form><br>
        <h3>Lista de animais cadastrados:</h3>
        <div class="table-responsive">
        <table class="responsive-table" >
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Nome</th>
                    <th>Raça</th>
                    <th>Tipo</th>
                    <th>Adotado</th>
                </tr>
            </thead>
            <tbody>
                <% animais.forEach(function(animal) { %>
                <tr>
                    <td data-label="ID"><%= animal.id %></td>
                    <td data-label="Nome"><%= animal.nome %></td>
                    <td data-label="Raça"><%= animal.raça %></td>
                    <td data-label="Tipo"><%= animal.tipo %></td>
                    <td data-label="Adotado"><%= animal.adotado ? 'Sim' : 'Não' %></td>
                </tr>
                <% }); %>
            </tbody>
        </table>
        </div>

        <form action="/animal/adicionarAnimal" method="POST">
            Nome: <input type="text" name="nome"><br>
            Raça: <input type="text" name="raca"><br>
            Tipo: <input type="text" name="tipo"><br>
            <button type="submit">Cadastrar novo</button>
        </form><br>

        <form action="/animal/editarAnimal" method="PUT">
            <input type="text" id="id_animal" name="id_animal" required>
            <button type="submit">Editar (não mexer ainda) </button>
        </form><br>
        </div>
    </div>


    <div class="section">
        <button class="accordion">Responsáveis</button>
        <div class="panel">
        <h3>Listar todos responsáveis</h3>
        <form action="/responsavel/responsavelPorId" method="POST">
            Id do responsável: <input type="text" id="id_responsavel" name="id_responsavel" required>
            <button type="submit">Buscar por ID</button>
        </form><br>
        <div class="table-responsive">
        <table class="responsive-table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Nome</th>
                    <th>Email</th>
                </tr>
            </thead>
            <tbody>
                <% responsaveis.forEach(function(responsavel) { %>
                <tr>
                    <td data-label="ID"><%= responsavel.id %></td>
                    <td data-label="Nome"><%= responsavel.nome %></td>
                    <td data-label="Email"><%= responsavel.email %></td>
                </tr>
                <% }); %>
            </tbody>
        </table>
        </div>
    </div>
    </div>


    <div class="section">
        <button class="accordion">Adoções</button>
        <div class="panel">
        <h3>Listar todas as adoções</h3>
        <form action="/adocao/listarPorResponsavel" method="POST">
            Nome do responsável: <input type="text" name="responsavel_nome" required>
            <button type="submit">Listar adoções por responsável</button>
        </form><br>
        <div class="table-responsive">
        <table class="responsive-table">
            <thead>
                <tr>
                    <th>Responsável</th>
                    <th>ID do Animal</th>
                    <th>Nome do Animal</th>
                    <th>Data da Adoção</th>
                </tr>
            </thead>
            <tbody>
                <% adocoes.forEach(function(adocao) { %>
                <tr>
                    <td data-label="Responsável"><%= adocao.responsavel_nome %></td>
                    <td data-label="ID do Animal"><%= adocao.animal_id %></td>
                    <td data-label="Nome do Animal"><%= adocao.animal_nome %></td>
                    <td data-label="Data da Adoção"><%= adocao.data_adocao %></td>
                </tr>
                <% }); %>
            </tbody>
        </table>
        </div>
    </div>
    </div>


    <div class="section">
        <button class="accordion">Veterinários</button>
        <div class="panel">
        <h3>Listar todos os veterinários</h3>
        <div class="table-responsive">
        <table class="responsive-table">
            <thead>
                <tr>
                    <th>Nome</th>
                    <th>Prontuário</th>
                    <th>Formação</th>
                </tr>
            </thead>
            <tbody>
                <% veterinarios.forEach(function(vet) { %>
                <tr>
                    <td data-label="Nome"><%= vet.nome %></td>
                    <td data-label="Prontuário"><%= vet.prontuario %></td>
                    <td data-label="Formação"><%= vet.formacao %></td>
                </tr>
                <% }); %>
            </tbody>
        </table>
        </div>

        <form action="/veterinario/criarVet" method="POST">
            Nome: <input type="text" name="nome" required><br>
            Prontuário: <input type="text" name="prontuario" required><br>
            Formação: <input type="text" name="formacao" required><br>
            <button type="submit">Cadastrar novo</button>
        </form><br>

        <h3>não vou fazer put e delete ainda, mas tá pronto</h3>
        </div>
    </div>


    <div class="section">
        <button class="accordion">Exames</button>
        <div class="panel">
        <h3>Listar todos os exames</h3>
        <div class="table-responsive">
        <table class="responsive-table">
            <thead>
                <tr>
                    <th>ID do Animal</th>
                    <th>Prontuário do Veterinário</th>
                    <th>Data do Exame</th>
                    <th>Resultados</th>
                </tr>
            </thead>
            <tbody>
                <% exames.forEach(function(exame) { %>
                <tr>
                    <td data-label="ID do Animal"><%= exame.id_animal %></td>
                    <td data-label="Prontuário do Veterinário"><%= exame.vet_prontuario %></td>
                    <td data-label="Data do Exame"><%= exame.data_exame %></td>
                    <td data-label="Resultados"><%= exame.observacoes %></td>
                </tr>
                <% }); %>
            </tbody>
        </table>
        </div>

        <form action="/exame/criarExame" method="POST">
            Id do animal: <input type="text" name="id_animal" required> <br>
            Prontuário do Veterinário: <input type="text" name="vet_prontuario" required><br>
            Resultados: <input type="text" name="resultados" required><br>
            <br>
            <button type="submit">Cadastrar exame</button>
        </form><br>

        <form action="/exame/listarPorVet" method="POST">
            Id do veterinário: <input type="text" name="vet_prontuario" required>
            <button type="submit">Listar exames por veterinário</button>
        </form><br>
        </div>
    </div>

    </div> <!-- .sections -->

            <form action="/admin/logout" method="GET">
                <button type="submit">Logout</button>
            </form>

    <script>
        var acc = document.getElementsByClassName("accordion");
        for (var i = 0; i < acc.length; i++) {
            acc[i].addEventListener("click", function() {
                var isActive = this.classList.contains('active');

                // Close all sections first
                for (var j = 0; j < acc.length; j++) {
                    acc[j].classList.remove('active');
                    var p = acc[j].nextElementSibling;
                    if (p) p.style.display = 'none';
                    var parent = acc[j].closest('.section');
                    if (parent) parent.classList.remove('open');
                }

                // If it wasn't active, open the clicked one and expand it
                if (!isActive) {
                    this.classList.add('active');
                    var panel = this.nextElementSibling;
                    if (panel) panel.style.display = 'block';
                    var parentSection = this.closest('.section');
                    if (parentSection) parentSection.classList.add('open');
                }
            });
        }
    </script>

</body>
</html>