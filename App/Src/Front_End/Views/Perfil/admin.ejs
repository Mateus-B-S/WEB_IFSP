<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin_perfil</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="/css/style.css">
    <style>
        /* page title styles */
        .page-header{
            text-align: center;
            margin: 18px 0 8px 0;
        }
        .page-title{
            display: inline-block;
            margin: 0;
            padding: 12px 22px;
            border-radius: 12px;
            background: linear-gradient(135deg,#6dd5ed 0%, #2193b0 100%);
            color: #ffffff;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            font-size: 24px;
            box-shadow: 0 6px 18px rgba(33,147,176,0.18);
            letter-spacing: 0.6px;
        }
        .page-subtitle{
            margin: 8px 0 0 0;
            color: #555;
            font-size: 13px;
        }

        @media (max-width: 600px){
            .page-title{font-size:18px;padding:10px 14px}
            .page-subtitle{font-size:12px}
        }
    </style>
</head>
<body>
    <%- include('../../Publico/partials/header.ejs') %>
    <%- include('../../Publico/partials/navbar.ejs') %>
    <header class="page-header">
        <h1 class="page-title">Perfil do Admin</h1>
        <p class="page-subtitle">Gerencie animais, responsáveis, adoções, veterinários e exames</p>

    </header>


    <div class="sections" style="padding: 10px;">

        <div class="section">
            <button class="accordion">Animais</button>
            <div class="panel">
            <form action="/animal/buscarPorId" method="GET">
                Id do animal: <input type="number" id="id_animal" name="id" required>
                <button type="submit">Buscar por ID</button>
            </form><br>
            <h3>Lista de animais cadastrados:</h3>
            <div class="table-responsive">
            <table class="responsive-table" >
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Nome</th>
                        <th>Raça</th>
                        <th>Adotado</th>
                        <th>ações</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (!animais || animais.length === 0) { %>
                    <tr>
                        <td colspan="5">Nenhum animal cadastrado.</td>
                    </tr>
                    <% } else { %>
                    <% (animais || []).forEach(function(animal) { %>
                    <tr>
                        <td data-label="ID"><%= animal.id %></td>
                        <td data-label="Nome"><%= animal.nome %></td>
                        <td data-label="Raça"><%= animal.raca %></td>
                        <td data-label="Adotado"><%= animal.adotado ? 'Sim' : 'Não' %></td>
                        <% if (animal.adotado) { %>
                        <td data-label="Ações">
                            <form action="/animal/devolver?_method=PUT" method="POST" style="display:inline;">
                                <input type="hidden" name="id" value="<%= animal.id %>">
                                <button class="btn btn-warning" type="submit" onclick="return confirm('Tem certeza que deseja devolver este animal?');"><i class="bi bi-arrow-counterclockwise bs-warning md"></i>Devolver</button>
                            </form>
                        </td>
                        <% } else { %>
                        <td data-label="Ações">
                            <form action="/animal/deletar?_method=DELETE" method="POST" style="display:inline;">
                                <input type="hidden" name="id" value="<%= animal.id %>">
                                <button class="btn btn-danger" type="submit" onclick="return confirm('Tem certeza que deseja deletar este animal?');"><i class="bi bi-trash-fill bs-danger md"></i></button>
                            </form>
                        </td>
                        <% } %>
                    </tr>
                    <% }); %>
                    <% } %>
                </tbody>
            </table>
            </div>

            <form action="/animal/criar" method="POST">
                Nome: <input type="text" name="nome"><br>
                Raça: <input type="text" name="raca"><br>
                <button type="submit">Cadastrar novo</button>
            </form><br>

            </div>
        </div>


        <div class="section">
            <button class="accordion">Responsáveis</button>
            <div class="panel">
            <h3>Listar todos responsáveis</h3>
            <form action="/responsavel/responsavelPorId" method="POST">
                Id do responsável: <input type="text" id="id_responsavel" name="id_responsavel" required>
                <button type="submit">Buscar por ID</button>
            </form><br>
            <div class="table-responsive">
            <table class="responsive-table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Nome</th>
                        <th>Email</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (!responsaveis || responsaveis.length === 0) { %>
                    <tr>
                        <td colspan="3">Nenhum responsável encontrado.</td>
                    </tr>
                    <% } else { %>
                    <% (responsaveis || []).forEach(function(responsavel) { %>
                    <tr>
                        <td data-label="ID"><%= responsavel.id %></td>
                        <td data-label="Nome"><%= responsavel.nome %></td>
                        <td data-label="Email"><%= responsavel.email %></td>
                    </tr>
                    <% }); %>
                    <% } %>
                </tbody>
            </table>
            </div>
        </div>
    </div>


    <div class="section">
        <button class="accordion">Adoções</button>
        <div class="panel">
        <h3>Listar todas as adoções</h3>
        <form action="/adocao/listarPorResponsavel" method="POST">
            Nome do responsável: <input type="text" name="responsavel_nome" required>
            <button type="submit">Listar adoções por responsável</button>
        </form><br>
        <div class="table-responsive">
        <table class="responsive-table">
            <thead>
                <tr>
                    <th>Responsável</th>
                    <th>ID do Animal</th>
                    <th>Nome do Animal</th>
                    <th>Data da Adoção</th>
                </tr>
            </thead>
            <tbody>
                <% if (!adocoes || adocoes.length === 0) { %>
                <tr>
                    <td colspan="4">Nenhuma adoção registrada.</td>
                </tr>
                <% } else { %>
                <% (adocoes || []).forEach(function(adocao) { %>
                <tr>
                    <td data-label="Responsável"><%= adocao.responsavel ? adocao.responsavel.nome : adocao.responsavel_nome %></td>
                    <td data-label="ID do Animal"><%= adocao.animal_id %></td>
                    <td data-label="Nome do Animal"><%= adocao.animal ? adocao.animal.nome : adocao.animal_nome %></td>
                    <td data-label="Data da Adoção"><%= adocao.data_adocao %></td>
                </tr>
                <% }); %>
                <% } %>
            </tbody>
        </table>
        </div>
    </div>
    </div>


    <div class="section">
        <button class="accordion">Veterinários</button>
        <div class="panel">
        <h3>Listar todos os veterinários</h3>
        <div class="table-responsive">
        <table class="responsive-table">
            <thead>
                <tr>
                    <th>Nome</th>
                    <th>Prontuário</th>
                    <th>Formação</th>
                    <th>Deletar</th>
                </tr>
            </thead>
            <tbody>
                <% if (!veterinarios || veterinarios.length === 0) { %>
                <tr>
                    <td colspan="3">Nenhum veterinário cadastrado.</td>
                </tr>
                <% } else { %>
                <% (veterinarios || []).forEach(function(vet) { %>
                <tr>
                    <td data-label="Nome"><%= vet.nome %></td>
                    <td data-label="Prontuário"><%= vet.prontuario %></td>
                    <td data-label="Formação"><%= vet.formacao %></td>
                    <td data-label="Deletar">
                        <form action="/veterinario/deletar?_method=DELETE" method="POST" onsubmit="return confirm('Tem certeza que deseja deletar este veterinário?');">
                            <input type="hidden" name="id" value="<%= vet.id %>">
                            <button type="submit" class="btn btn-danger btn-sm"><i class="bi bi-trash-fill bs-danger md"></i></button>
                        </form>
                </tr>
                <% }); %>
                <% } %>
            </tbody>
        </table>
        </div>

        <form action="/veterinario/criarVet" method="POST">
            Nome: <input type="text" name="nome" required><br>
            Prontuário: <input type="text" name="prontuario" required><br>
            Formação: <input type="text" name="formacao" required><br>
            Senha: <input type="password" name="senha" required><br>
            <button type="submit">Cadastrar novo</button>
        </form><br>

        </div>
    </div>


    <div class="section">
        <button class="accordion">Exames</button>
        <div class="panel">
        <h3>Listar todos os exames</h3>
        <div class="table-responsive">
        <table class="responsive-table">
            <thead>
                <tr>
                    <th>Animal</th>
                    <th>Raça</th>
                    <th>Veterinário</th>
                    <th>Data do Exame</th>
                    <th>Resultados</th>
                </tr>
            </thead>
            <tbody>
                <% if (!exames || exames.length === 0) { %>
                <tr>
                    <td colspan="4">Nenhum exame registrado.</td>
                </tr>
                <% } else { %>
                <% (exames || []).forEach(function(exame) { %>
                <tr>
                    <td data-label="Animal"><%= exame.animal.nome %></td>
                    <td data-label="Raça"><%= exame.animal.raca %></td>
                    <td data-label="Veterinário"><%= exame.veterinario.nome %></td>
                    <td data-label="Data do Exame"><%= exame.data_exame %></td>
                    <td data-label="Resultados"><%= exame.observacoes %></td>
                </tr>
                <% }); %>
                <% } %>
            </tbody>
        </table>
        </div>

        <form action="/exame/criarExame" method="POST">
            Id do animal: <input type="text" name="id_animal" required> <br>
            Prontuário do Veterinário: <input type="text" name="vet_prontuario" required><br>
            Resultados: <input type="text" name="resultados" required><br>
            <br>
            <button type="submit">Cadastrar exame</button>
        </form><br>

        <form action="/exame/listarPorVet" method="POST">
            Prontuario do veterinário: <input type="text" name="vet_prontuario" required>
            <button type="submit">Listar exames por veterinário</button>
        </form><br>
        </div>
    </div>

    </div> <!-- .sections -->

            <form action="/admin/logout" method="GET">
                <button class="btn btn-danger" type="submit">Logout</button>
            </form>

    <script>
        var acc = document.getElementsByClassName("accordion");
        for (var i = 0; i < acc.length; i++) {
            acc[i].addEventListener("click", function() {
                var isActive = this.classList.contains('active');

                // Close all sections first
                for (var j = 0; j < acc.length; j++) {
                    acc[j].classList.remove('active');
                    var p = acc[j].nextElementSibling;
                    if (p) p.style.display = 'none';
                    var parent = acc[j].closest('.section');
                    if (parent) parent.classList.remove('open');
                }

                // If it wasn't active, open the clicked one and expand it
                if (!isActive) {
                    this.classList.add('active');
                    var panel = this.nextElementSibling;
                    if (panel) panel.style.display = 'block';
                    var parentSection = this.closest('.section');
                    if (parentSection) parentSection.classList.add('open');
                }
            });
        }
    </script>

</body>
 <% - include('../../Publico/partials/footer.ejs') %>
</html>