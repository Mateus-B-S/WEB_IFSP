<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Perfil_Vet</title>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
      rel="stylesheet"
      integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB"
      crossorigin="anonymous"
    />
    <link href="/css/style.css" rel="stylesheet" />
    <style>
      body {
        margin-right: 0;
        overflow-x: hidden;
      }
      @media (max-width: 768px) {
        body {
          margin-left: 0;
        }
      }
    </style>
  </head>
  <body>
    <%- include('../../Publico/partials/header.ejs') %> <%-
    include('../../Publico/partials/navbar.ejs') %>
    <div class="container-fluid">
        <h1>Perfil de <%= nome %></h1>
        
        <div class="section">
            <h2>Exames Médicos Realizados</h2>
            <% if (exames && exames.length > 0) { %>
            <div class="table-responsive">
                <table class="responsive-table">
                    <thead>
                        <tr>
                            <th>ID Animal</th>
                            <th>Data</th>
                            <th>Observações</th>
                            <th>Deletar</th>
                            <th>Editar</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% exames.forEach(function(exame) { %>
                        <tr>
                            <td><%= exame.id_animal %></td>
                            <td><%= exame.data_exame %></td>
                            <td><%= exame.observacoes %></td>
                            <td>
                                <form action="/exame/deletar?_method=DELETE" method="POST" onsubmit="return confirm('Tem certeza que deseja deletar este exame?');">
                                    <input type="hidden" name="id" value="<%= exame.id %>">
                                    <button type="submit" class="btn btn-danger btn-sm">Deletar</button>
                                </form>
                            </td>
                            <td>
                                <form action="/exame/editar?_method=PUT" method="POST">
                                    <input type="hidden" name="id" value="<%= exame.id %>">
                                    <input type="hidden" name="id_animal" value="<%= exame.id_animal %>">
                                    <input type="hidden" name="data_exame" value="<%= exame.data_exame %>">
                                    <div class="form-group">
                                        <label for="observacoes">Observações</label>
                                        <textarea id="observacoes" name="observacoes" class="form-control" rows="4" required></textarea>
                                    </div>
                                    <button type="submit" class="btn btn-warning btn-sm">Editar</button>
                                </form>
                            </td>
                        </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
            <% } else { %>
            <p class="text-muted">Nenhum exame realizado ainda.</p>
            <% } %>
        </div>

        <div class="section">
            <h2>Cadastrar Novo Exame</h2>
            <form action="/exame/criarExame" method="POST" class="needs-validation">

                <input type="hidden" name="prontuario_vet" value="<%= prontuario %>">
                
                <div class="form-group">
                    <label for="id_animal">ID do Animal</label>
                    <input type="number" id="id_animal" name="id_animal" class="form-control" required>
                </div>
                
                
                <input type="hidden" name="data_exame" value="<%= new Date().toISOString().split('T')[0] %>">
       
                <div class="form-group">
                    <label for="observacoes">Observações</label>
                    <textarea id="observacoes" name="observacoes" class="form-control" rows="4" required></textarea>
                </div>

                
                <button type="submit" class="btn btn-primary">Cadastrar Exame</button>
            </form>
        </div>
        <% } else { %>
        <p class="text-muted">Nenhum exame realizado ainda.</p>
        <% } %>
      </div>

      <div class="section">
        <h2>Cadastrar Novo Exame</h2>
        <form action="/exame/criarExame" method="POST" class="needs-validation">
          <div class="form-group">
            <label for="id_animal">ID do Animal</label>
            <input
              type="number"
              id="id_animal"
              name="id_animal"
              class="form-control"
              required
            />
          </div>

          <div class="form-group">
            <label for="vet_prontuario">Prontuário do Veterinário</label>
            <input
              type="text"
              id="vet_prontuario"
              name="vet_prontuario"
              class="form-control"
              required
            />
          </div>

          <div class="form-group">
            <label for="observacoes">Observações</label>
            <textarea
              id="observacoes"
              name="observacoes"
              class="form-control"
              rows="4"
              required
            ></textarea>
          </div>

          <button type="submit" class="btn btn-primary">Cadastrar Exame</button>
        </form>
      </div>

      <form action="/veterinario/logout" method="POST" class="mt-3">
        <button type="submit" class="btn btn-danger">Logout</button>
      </form>
    </div>

    <script
      src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.11.8/dist/umd/popper.min.js"
      integrity="sha384-I7E8VVD/ismYTF4hNIPjVp/Zjvgyol6VFvRkX/vR+Vc4jQkC+hVqc2pM8ODewa9r"
      crossorigin="anonymous"
    ></script>
    <script
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.min.js"
      integrity="sha384-G/EV+4j2dNv+tEPo3++6LCgdCROaejBqfUeNjuKAiuXbjrxilcCdDz6ZAVfHWe1Y"
      crossorigin="anonymous"
    ></script>
    <%- include('../../Publico/partials/footer.ejs') %>
  </body>
</html>
