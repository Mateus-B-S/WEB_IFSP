<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>Responsavel_perfil</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <link href="/css/style.css" rel="stylesheet">
</head>
<body>
    <%- include('../../Publico/partials/header.ejs') %>
    <%- include('../../Publico/partials/navbar.ejs') %>
    <div class="container-fluid">
        <h1>Olá, <%= nome %>!</h1>
        <h2>Seus Animais Adotados</h2>
        <div class="cards-grid">
            <% (animaisResponsavel || [] ).forEach(function(animalResp) { %>
            <div class="card">
                <div class="card-header bg-light">
                    <div class="card-header-custom">
                        <div class="avatar"><%= (animalResp.animal && animalResp.animal.nome && animalResp.animal.nome.charAt(0)) ? animalResp.animal.nome.charAt(0).toUpperCase() : 'A' %></div>
                        <div>
                            <h5 class="card-title mb-1"><%= animalResp.animal ? animalResp.animal.nome : animalResp.animal_nome %></h5>
                            <p class="card-text text-muted mb-0" style="font-size:13px"><strong>Raça:</strong> <%= animalResp.animal ? animalResp.animal.raca : animalResp.animal_raca %></p>
                        </div>
                    </div>
                </div>
                <div class="card-body">
                    <p class="card-text" style="font-size:13px;color:#6c757d"><strong>Data de Adoção:</strong> <%= animalResp.data_adocao %></p>
                </div>
            </div>
            <% }); %>
        </div>
    </div>

    <h2>Animais para adoção</h2>
    <div class="container-fluid">
        <div class="cards-grid" >
            <% (animaisAdocao || [] ).forEach(function(animal) { %>
                <div class="card" data-id="<%= animal.id %>">
                <div class="card-header bg-light">
                    <div class="card-header-custom">
                        <div class="avatar"><%= (animal.nome && animal.nome.charAt(0)) ? animal.nome.charAt(0).toUpperCase() : 'A' %></div>
                        <div>
                            <h5 class="card-title mb-1"><%= animal.nome %></h5>
                            <p class="card-text text-muted mb-0" style="font-size:13px"><strong>Raça:</strong> <%= animal.raca %></p>
                            <p class="card-text text-muted mb-0" style="font-size:13px"><strong>Tipo:</strong> <%= animal.tipo %></p>
                        </div>
                    </div>
                </div>
                <div class="card-body"></div>
                <div class="card-footer bg-light">
                    <form action="/adocao/adotarAnimal" method="POST" style="width:100%">
                        <input type="hidden" name="data_adocao" value="<%= new Date().toISOString().split('T')[0] %>">
                        <input type="hidden" name="animal_id" value="<%= animal.id %>">
                        <input type="hidden" name="responsavel_id" value="<%= responsavel_id %>">
                        <input type="hidden" name="nome_animal" value="<%= animal.nome %>">
                        <button type="submit" class="btn btn-primary btn-sm w-100" onclick="return confirm('Você realmente deseja adotar esse animal?')">Adotar</button>
                    </form>
                </div>
            </div>
        </div>
        <!-- Modal for zoomed card -->
        <div id="modalBackdrop" class="modal-backdrop" aria-hidden="true">
            <div id="modal" class="modal" role="dialog" aria-modal="true">
                <div class="modal-inner">
                    <div class="modal-avatar" id="modalAvatar">A</div>
                    <div class="modal-content">
                        <h3 id="modalName">Nome</h3>
                        <p id="modalRaca"><strong>Raça:</strong> ...</p>
                        <p id="modalTipo"><strong>Tipo:</strong> ...</p>
                        <div class="modal-actions">
                            <form id="modalAdoptForm" action="/adocao/adotarAnimal" method="POST">
                                <input type="hidden" name="animal_id" id="modalAnimalId" value="<%= animal.id %>">
                                <input type="hidden" name="responsavel_nome" value="<%= nome %>">
                                <button type="submit" class="btn btn-primary btn-sm">Adotar</button>
                            </form>
                            <button class="btn btn-secondary btn-sm" id="modalClose">Fechar</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <% }); %>

        <form action="/responsavel/logout" method="POST" style="margin-top:18px">
            <button type="submit" class="btn btn-danger">Logout</button>
        </form>
    
    

    <script>
        // modal logic: open when clicking a card, populate with card data
            (function(){
        const cards = document.querySelectorAll('.card');
        const backdrop = document.getElementById('modalBackdrop');
        const modal = document.getElementById('modal');
        const modalAvatar = document.getElementById('modalAvatar');
        const modalName = document.getElementById('modalName');
        const modalRaca = document.getElementById('modalRaca');
        const modalTipo = document.getElementById('modalTipo');
        const modalAnimalId = document.getElementById('modalAnimalId');
        const modalClose = document.getElementById('modalClose');
        const modalAdoptForm = document.getElementById('modalAdoptForm');
        let currentCard = null;

        function openModal(data, card){
            currentCard = card;

            // Preenche modal
            modalAvatar.textContent = data.nome ? data.nome.charAt(0).toUpperCase() : 'A';
            modalName.textContent = data.nome || '—';
            modalRaca.innerHTML = `<strong>Raça:</strong> ${data.animal.raca || '—'}`;
            modalTipo.innerHTML = `<strong>Tipo:</strong> ${data.animal.tipotipo || '—'}`;
            modalAnimalId.value = data.id || '';

            // Clone do card
            const cardRect = card.getBoundingClientRect();
            const clone = card.cloneNode(true);
            clone.classList.add('fly-clone');
            clone.style.left = cardRect.left + 'px';
            clone.style.top = cardRect.top + 'px';
            clone.style.width = cardRect.width + 'px';
            clone.style.height = cardRect.height + 'px';
            document.body.appendChild(clone);

            // Mostra backdrop
            backdrop.style.display = 'flex';
            requestAnimationFrame(() => backdrop.style.background = 'rgba(10,20,30,0.55)');

            // Posição final do modal
            const modalRect = modal.getBoundingClientRect();
            const targetLeft = window.innerWidth/2 - cardRect.width/2;
            const targetTop = window.innerHeight/2 - cardRect.height/2;

            requestAnimationFrame(() => {
                clone.style.left = (window.innerWidth - clone.offsetWidth)/2 + 'px';
                clone.style.top = (window.innerHeight - clone.offsetHeight)/2 + 'px';
                clone.style.width = '90%';
                clone.style.height = 'auto';
            });

            clone.addEventListener('transitionend', function handler(){
                clone.removeEventListener('transitionend', handler);
                modal.classList.add('open');
                clone.remove();
            });
        }

        function closeModal(){
            if(!currentCard) return;

            const cardRect = currentCard.getBoundingClientRect();
            const clone = modal.cloneNode(true);
            clone.classList.add('fly-clone');
            clone.style.position = 'absolute';
            clone.style.left = (window.innerWidth - clone.offsetWidth)/2 + 'px';
            clone.style.top = (window.innerHeight - clone.offsetHeight)/2 + 'px';
            clone.style.width = modal.offsetWidth + 'px';
            clone.style.height = modal.offsetHeight + 'px';
            document.body.appendChild(clone);

            modal.classList.remove('open');

            requestAnimationFrame(() => {
                clone.style.left = cardRect.left + 'px';
                clone.style.top = cardRect.top + 'px';
                clone.style.width = cardRect.width + 'px';
                clone.style.height = cardRect.height + 'px';
                backdrop.style.background = 'rgba(10,20,30,0)';
            });

            clone.addEventListener('transitionend', () => {
                clone.remove();
                backdrop.style.display = 'none';
                currentCard = null;
            });
        }

        cards.forEach(card => {
            card.addEventListener('click', e => {
                if(e.target.closest('form') || e.target.closest('button')) return;
                const id = card.dataset.id;
                const nome = card.querySelector('.card-title')?.textContent || '';
                const raca = card.querySelectorAll('.card-text')[0]?.textContent.replace('Raça:','').trim() || '';
                const tipo = card.querySelectorAll('.card-text')[1]?.textContent.replace('Tipo:','').trim() || '';
                openModal({id,nome,raça:raca,tipo}, card);
            });
        });

        modalClose.addEventListener('click', closeModal);
        backdrop.addEventListener('click', e => { if(e.target === backdrop) closeModal(); });
        document.addEventListener('keydown', e => { if(e.key === 'Escape') closeModal(); });
    })();

    </script>
    <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.11.8/dist/umd/popper.min.js" integrity="sha384-I7E8VVD/ismYTF4hNIPjVp/Zjvgyol6VFvRkX/vR+Vc4jQkC+hVqc2pM8ODewa9r" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.min.js" integrity="sha384-G/EV+4j2dNv+tEPo3++6LCgdCROaejBqfUeNjuKAiuXbjrxilcCdDz6ZAVfHWe1Y" crossorigin="anonymous"></script>
    
</body>
<footer>
    <%- include('../../Publico/partials/footer.ejs') %>
</footer>
</html>