<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <title>Adoções por Responsável</title>
</head>
<body>
    <h1><strong>Todas as adoções de <%= nomeResponsavel%></strong></h1>
       <table border="1" style="border-collapse:collapse;width:50%;text-align:center;">
            <thead>
                <tr>
                    <th>ID do animal</th>
                    <th>Nome</th>
                    <th>Raça</th>
                    <th>Data da adoção</th>
                </tr>
            </thead>
            <tbody>
                <% adocoes.forEach(function(adocao) { %>
                <tr>
                    <td><%= adocao.animal_id %></td>
                    <td><%= adocao.animal_nome %></td>
                    <td><%= adocao.animal_raça %></td>
                    <td><%= adocao.data_adocao %></td>
                </tr>
                <% }); %>
            </tbody>
        </table>
     <form action="/admin/" method="POST">
        <input type="hidden" name="senha" value="<%= adminSenha %>">
        <button type="submit" class="btn btn-primary">Voltar ao perfil</button>
    </form>
</body>
</html>