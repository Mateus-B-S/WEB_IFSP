
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/detalhesAnimal.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css" rel="stylesheet">
    <script defer src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Lexend+Deca:wght@100..900&display=swap');
    </style>
    <title>perfil Livro</title>
</head>
<body>
    <div class="paginaEspecifica">
        <header>
            <%- include('../../../Publico/partials/header') %>
            <%- include("../../../Publico/partials/navbar") %>
        </header>
    </div>
<section class="section " style="background-color: #f5f1e8;">
    <main class="section vh-100" style="background-color: #f5f1e8;">
        <div class="esquerda">
            <h1><%= animal.nome %></h1>
            <p id="descricao"><%= animal.descricao %></p>
        </div>

        <div class="centro">
            <div class="capaLivro">
                <img src="<%= animal.imagem %>" class="img-fluid" height="225" alt="<%= animal.nome %>">
                <input type="hidden" name="titulo" value="<%= animal.nome %>"> 
            </div>
        </div>

        <div class="direita">
            <p id="autor">Raça: <%= animal.raca %></p>
            <p id="categoria">Tipo: <%= animal.tipo %></p>
            <% if(!exames || exames.length === 0) { %>
                <p id="classific">Nenhum exame registrado.</p>
            <% } else { %>
                <% exames.forEach(function(exame) { %>
                    <ul>
                        <li>
                            <p id="classific">Exame em <%= exame.data_exame %>: <%= exame.observacoes %> <br>( Por: <%= exame.veterinario.nome %> )</p>
                        </li>
                    </ul>
                <% }); %>
            <% } %>
            
             
        <form action="/responsavel/" method="POST" style:="text-align: center;">
            <input type="hidden" name="nome" value="<%= respNome %>">
            <input type="hidden" name="email" value="<%= respEmail %>">
            <input type="hidden" name="senha" value="<%= respSenha %>">
            <input type="hidden" name="id" value="<%= respId %>">
            <div class="text-center mb-4" id="logout-button">
                <button type="submit" class="btn btn-primary">Voltar ao Perfil</button>
            </div>
        </form>
        </div>
        
    </main>
    </section>  

        
</body>
</html>

