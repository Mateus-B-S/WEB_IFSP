<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Confirmação de adoção</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
</head>
<header> </header>
<body>
        <div class="container py-5 h-100">
        <div class="row d-flex justify-content-center align-items-center h-100">
            <div class="col-12 col-md-8 col-lg-6 col-xl-5">
                <div class="card shadow-2-strong" style="border-radius: 1rem;">
                    <div class="card-body p-5 text-center">
                        <h1>Confirmação de Adoção</h1>
                        <h2>Dados da Adoção: </h2>
                        <p>Nome do Responsável: <%= adocao.responsavel_nome %></p>
                        <p>Nome do animal: <%= adocao.animal_nome %> </p>
                        <p>ID do Animal: <%= adocao.animal_id %></p>
                        <p>Data da Adoção: <%= adocao.data_adocao %></p>
                        <p>Sua adoção foi realizada com sucesso!</p>
                        <form action="/responsavel/" method="POST">
                            <input type="hidden" name="senha" value="<%= senhaResponsavel %>">
                            <input type="hidden" name="email" value="<%= emailResponsavel %>">
                            <button type="submit" class="btn btn-primary">Voltar ao perfil</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
