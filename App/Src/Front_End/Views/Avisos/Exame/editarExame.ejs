<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Exame Editado</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <link href="/css/style.css" rel="stylesheet">
</head>
<body>
    <div class="app-main">
        <div class="container-fluid">
            <div class="card" style="max-width: 600px; margin: 40px auto;">
                <div class="card-body">
                    <h2 class="card-title text-center mb-4">✅ Exame Editado com Sucesso!</h2>
                    <div class="form-group">
                        <label><strong>Observações:</strong></label>
                        <textarea class="form-control" rows="6" readonly><%= exame.observacoes %></textarea>
                    </div>
                    <form action="/veterinario/" method="POST" class="mt-4">
                        <input type="hidden" name="nome" value="<%= nome %>">
                        <input type="hidden" name="prontuario" value="<%= prontuario %>">
                        <input type="hidden" name="senha" value="<%= senha %>">
                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary">Voltar ao Perfil</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</body>
</html>