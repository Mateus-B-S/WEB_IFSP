<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>exame_editado</title>
</head>
<body>
    <h1>Exame editado com sucesso!</h1>
    <textarea rows="4" cols="50" readonly><%= exame.observacoes %></textarea>
    <form action="/veterinario/" method="POST">
        <input type="hidden" name="nome" value="<%= nome %>">
        <input type="hidden" name="prontuario" value="<%= prontuario %>">
        <input type="hidden" name="senha" value="<%= senha %>">
        <button type="submit">Voltar ao Perfil</button>
    </form >
</body>
</html>