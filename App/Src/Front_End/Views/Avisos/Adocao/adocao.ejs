<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Confirmação de Adoção</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <link href="/css/style.css" rel="stylesheet">
</head>
<body>
    <div class="app-main">
        <div class="container-fluid">
            <div class="card" style="max-width: 600px; margin: 40px auto;">
                <div class="card-body">
                    <h2 class="card-title text-center mb-4">✅ Adoção Confirmada!</h2>
                    <div class="card-text">
                        <p><strong>Responsável:</strong> <%= adocao.responsavel? adocao.responsavel.nome : adocao.responsavel_nome %></p>
                        <p><strong>Animal:</strong> <%= adocao.animal ? adocao.animal.nome : adocao.animal_nome%></p>
                        <p><strong>Raça:</strong> <%= adocao.animal ? adocao.animal.raca : adocao.animal_raca %></p>
                        <p><strong>Data da Adoção:</strong> <%= adocao.data_adocao %></p>
                        <p class="text-center text-muted mt-4">Sua adoção foi realizada com sucesso! 🎉</p>
                    </div>
                    <form action="/responsavel/" method="POST" class="mt-4">
                        <input type="hidden" name="nome" value="<%= nomeResponsavel %>">
                        <input type="hidden" name="senha" value="<%= senhaResponsavel %>">
                        <input type="hidden" name="email" value="<%= emailResponsavel %>">
                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary">Voltar ao Perfil</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</body>
</html>