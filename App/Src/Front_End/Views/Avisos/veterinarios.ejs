<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <title>confirmação_veterinario</title>
</head>
<body>
    <h1>Confirmação de novo Veterinario:</h1>
    <p>Nome: <%= veterinario.nome %></p>
    <p>Prontuário: <%= veterinario.prontuario %></p>
    <p>formação: <%= veterinario.formacao%></p>

    <form action="/admin/" method="POST">
        <input type="hidden" name="senha" value="<%= adminSenha %>">
        <button type="submit" class="btn btn-primary">Voltar ao perfil</button>
    </form>
    
</body>
</html>