<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
</head>
<body>
    <h1>Responsável Procurado:</h1>
    <table border="1" style="border-collapse:collapse;width:50%;text-align:center;">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Nome</th>
                    <th>Email</th>
                </tr>
            </thead>
            <tbody>
                
                <tr>
                    <td><%= responsavel.id %></td>
                    <td><%= responsavel.nome %></td>
                    <td><%= responsavel.email %></td>
                </tr>
            </tbody>
        </table>
    <form action="/admin/" method="POST">
        <input type="hidden" name="senha" value="<%= adminSenha %>">
        <button type="submit">Voltar ao perfil</button>
    </form>
</body>
</html>