<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <title>Exames por Veterinário</title>
</head>
<body>
    <h1>Todos os exames do(a) Doutor(a): <strong><%= nomeVet%></strong></h1>
    <table border="1" style="border-collapse:collapse;width:50%;text-align:center;">
            <thead>
                <tr>
                    <th>Prontuario</th>
                    <th>ID do animal</th>
                    <th>Data do Exame</th>
                    <th>Observações</th>
                </tr>
            </thead>
            <tbody>
                <% exames.forEach(function(exame) { %>
                <tr>
                    <td><%= prontuarioVet %></td>
                    <td><%= exame.id_animal %></td>
                    <td><%= exame.data_exame %></td>
                    <td><%= exame.observacoes %></td>
                </tr>
                <% }); %>
            </tbody>
        </table>
    <form action="/admin/" method="POST">
        <input type="hidden" name="senha" value="<%= adminSenha %>">
        <button type="submit" class="btn btn-primary">Voltar ao perfil</button>
    </form>
</body>
</html>