      <div class="d-flex flex-column align-items-center">
        <i class="bi bi-person-circle" style="font-size:48px;color:#2193b0"></i>
        <strong>Mateus</strong>
        <div class="text-muted">(11) 98765-4321</div>
      </div>

      <div class="d-flex flex-column align-items-center">
        <i class="bi bi-person-circle" style="font-size:48px;color:#2193b0"></i>
        <strong>Isa</strong>
        <div class="text-muted">(11) 91234-5678</div>
      </div>

      <div class="d-flex flex-column align-items-center">
        <i class="bi bi-person-circle" style="font-size:48px;color:#2193b0"></i>
        <strong>Moraes</strong>
        <div class="text-muted">(11) 99876-5432</div>
      </div>

      <div class="d-flex flex-column align-items-center">
        <i class="bi bi-person-circle" style="font-size:48px;color:#2193b0"></i>
        <strong>Luis</strong>
        <div class="text-muted">(11) 99123-4567</div>
      </div>
    </div>

  </main>

  <script defer src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js"></script>
